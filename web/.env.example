# ---------------------------------------------------------------
# Public frontend configuration.
#
# Only values that are SAFE TO EXPOSE in a browser bundle belong
# here. Never put SECRET_KEY, database credentials, SMTP
# passwords, SMS keys or payment provider secrets in a VITE_
# variable - they end up in the shipped JavaScript.
# ---------------------------------------------------------------

# Root of the Django server (no trailing slash, no /api suffix).
VITE_API_BASE_URL=http://10.240.41.56;

# Barber selection.
#
# The backend exposes GET /api/barbers/. While this is true the booking
# flow lets the customer choose a specific barber; when it is false it
# falls back to Django's automatic barber assignment.
VITE_ENABLE_BARBER_SELECTION=true
